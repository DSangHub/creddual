# Copy this file to backend/.env and fill in real values. Never commit .env.

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/creddual"

# JWT
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-secret-key-change-this-in-production"

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins
FRONTEND_URL="http://localhost:3000"
# Set to 1 when deployed behind a proxy (Vercel, Render, Railway, nginx) so
# rate limiting sees each visitor's real IP instead of the proxy's.
# TRUST_PROXY=1

# Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Payment (if integrating with Stripe or similar)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: Plaid for bank integration
PLAID_CLIENT_ID="..."
PLAID_SECRET="..."
PLAID_ENV="sandbox"
